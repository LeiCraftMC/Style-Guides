{
	"name": "leicraftmc-style-guides",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Style guide, shared utilities, brand assets, and project templates for the LeiCraftMC ecosystem (LeiOS, Delivr, NowIP, Vault, NetIgnite, ...).",
	"scripts": {
		"check": "bunx --bun biome check",
		"check:ci": "bunx --bun biome ci",
		"format": "bunx --bun biome format --write",
		"lint": "bunx --bun biome lint",
		"typecheck": "tsc -p ./tsconfig.json && echo 'Typecheck passed!'",
		"test": "bun test --path-ignore-patterns=\"templates/**\" --pass-with-no-tests"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@cleverjs/cli": "^2.4.0",
		"@types/bun": "^1.3.14",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.12.30",
		"hono-openapi": "^1.3.1",
		"typescript": "^5.9.3",
		"zod": "^4.4.3"
	}
}
