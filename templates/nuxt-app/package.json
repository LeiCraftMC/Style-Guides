{
	"name": "@leicraftmc/nuxt-app-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "bunx --bun biome check",
		"check:ci": "bunx --bun biome ci",
		"format": "bunx --bun biome format --write",
		"lint": "bunx --bun biome lint",
		"build": "nuxt build",
		"start": "bun run .output/server/index.mjs --port 12510",
		"dev": "nuxt dev --port 12510",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"api-client:generate": "openapi-ts && bun scripts/patch-api-client.ts",
		"typecheck": "nuxt typecheck && tsc -p ./tsconfig/tsconfig.typecheck.json && echo 'Typecheck passed!'",
		"test": "bun test"
	},
	"dependencies": {
		"@hey-api/nuxt": "^0.2.1",
		"@hey-api/openapi-ts": "^0.99.0",
		"@nuxt/ui": "^4.9.0",
		"nuxt": "^4.4.8",
		"vue": "^3.5.39",
		"vue-router": "^5.1.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@iconify-json/lucide": "^1.2.117",
		"bun-types": "^1.4.2",
		"typescript": "^6.0.3",
		"vue-tsc": "^3.3.6"
	}
}