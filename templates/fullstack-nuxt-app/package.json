{
	"name": "@leicraftmc/fullstack-nuxt-app-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nuxt build",
		"start": "bun run .output/server/index.mjs --port 3000",
		"dev": "nuxt dev --port 3000",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"api-client:generate": "openapi-ts",
		"db:generate": "bun scripts/db-utils.ts generate",
		"db:migrate": "bun scripts/db-utils.ts migrate",
		"db:push": "bun scripts/db-utils.ts push",
		"typecheck": "nuxt typecheck && tsc -p ./tsconfig/tsconfig.typecheck.json && echo 'Typecheck passed!'",
		"test": "bun test"
	},
	"dependencies": {
		"@hey-api/client-fetch": "^0.8.0",
		"@nuxt/ui": "^3.0.0",
		"@nuxt/ui-pro": "^3.0.0",
		"@scalar/hono-api-reference": "^0.5.0",
		"drizzle-orm": "^0.40.0",
		"drizzle-zod": "^0.7.0",
		"hono": "^4.7.0",
		"hono-openapi": "^0.4.0",
		"nuxt": "^3.16.0",
		"tailwindcss": "^4.0.0",
		"vue": "^3.5.0",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@hey-api/openapi-ts": "^0.64.0",
		"@types/bun": "latest",
		"drizzle-kit": "^0.30.0",
		"typescript": "^5.8.0"
	}
}