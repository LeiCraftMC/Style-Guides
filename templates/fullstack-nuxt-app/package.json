{
	"name": "@leicraftmc/fullstack-nuxt-app-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nuxt build",
		"start": "PORT=3000 bun run .output/server/index.mjs",
		"dev": "nuxt dev --port 3000",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"api-client:generate": "openapi-ts",
		"db:generate": "bun scripts/db-utils.ts && bunx --bun drizzle-kit generate --config=drizzle.config.ts",
		"db:migrate": "bun scripts/db-utils.ts && bunx --bun drizzle-kit migrate --config=drizzle.config.ts",
		"db:push": "bun scripts/db-utils.ts && bunx --bun drizzle-kit push --config=drizzle.config.ts",
		"typecheck": "nuxt typecheck && tsc -p ./tsconfig/tsconfig.typecheck.json && echo 'Typecheck passed!'",
		"test": "bun test"
	},
	"dependencies": {
		"@hey-api/nuxt": "^0.2.1",
		"@hey-api/openapi-ts": "^0.99.0",
		"@hono/standard-validator": "^0.3.0",
		"@nuxt/ui": "^4.9.0",
		"@scalar/hono-api-reference": "^0.11.9",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.12.30",
		"hono-openapi": "^1.3.1",
		"nuxt": "^4.4.8",
		"vue": "^3.5.39",
		"vue-router": "^5.1.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@iconify-json/lucide": "^1.2.117",
		"drizzle-kit": "^0.31.10",
		"bun-types": "^1.3.14",
		"typescript": "^6.0.3",
		"vue-tsc": "^3.3.6"
	}
}