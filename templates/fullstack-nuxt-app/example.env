# Nuxt public runtime config (same-origin app URL). Replace the port with a unique one (see docs/02 — Ports).
NUXT_PUBLIC_APP_URL=http://localhost:12520

# Backend env vars (Hono in server/). Replace FNA_ with your project prefix.
FNA_LOG_LEVEL=info
FNA_API_DISABLE_DOCS=false
FNA_DB_PATH=./data/db.sqlite
FNA_DB_AUTO_MIGRATE=true