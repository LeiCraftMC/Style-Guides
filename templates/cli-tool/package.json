{
	"name": "@leicraftmc/cli-tool-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "LeiCraft_MC CLI Tool Template",
	"scripts": {
		"check": "bunx --bun biome check",
		"check:ci": "bunx --bun biome ci",
		"format": "bunx --bun biome format --write",
		"lint": "bunx --bun biome lint",
		"typecheck": "bunx --bun tsc -p ./tsconfig/tsconfig.typecheck.json && echo 'Typecheck passed!'",
		"test": "bun test",
		"dev": "bun run --watch src/index.ts",
		"start": "bun run scripts/entrypoint.ts",
		"compile": "bun run ./scripts/compile"
	},
	"dependencies": {
		"@cleverjs/cli": "^2.4.0",
		"@cleverjs/utils": "^1.1.9",
		"dotenv": "^17.4.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@types/bun": "^1.4.2",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"typescript": "^6.0.3 || ^7.0.0"
	}
}
