{
	"name": "@leicraftmc/backend-service-template",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"typecheck": "tsc -p ./tsconfig/tsconfig.typecheck.json && echo 'Typecheck passed!'",
		"test": "bun test",
		"dev": "bun run --watch src/index.ts",
		"start": "bun run scripts/entrypoint.ts",
		"compile": "bun run ./scripts/compile",
		"db:generate": "bun scripts/db-utils.ts && bunx --bun drizzle-kit generate --config=drizzle.config.ts",
		"db:migrate": "bun scripts/db-utils.ts && bunx --bun drizzle-kit migrate --config=drizzle.config.ts",
		"db:push": "bun scripts/db-utils.ts && bunx --bun drizzle-kit push --config=drizzle.config.ts"
	},
	"dependencies": {
		"@cleverjs/utils": "^1.1.9",
		"@hono/standard-validator": "^0.2.2",
		"@scalar/hono-api-reference": "^0.11.9",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.12.30",
		"hono-openapi": "^1.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@cleverjs/cli": "^2.4.0",
		"@types/bun": "^1.3.14",
		"drizzle-kit": "^0.31.10",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"typescript": "^6.0.3 || ^7.0.0"
	}
}