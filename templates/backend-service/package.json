{
	"name": "@leicraftmc/backend-service-template",
	"private": true,
	"type": "module",
	"description": "LeiCraft_MC Backend Service Template",
	"scripts": {
		"check": "bunx --bun biome check",
		"check:ci": "bunx --bun biome ci",
		"format": "bunx --bun biome format --write",
		"lint": "bunx --bun biome lint",
		"typecheck": "bunx --bun tsc -p ./tsconfig/tsconfig.typecheck.json && echo 'Typecheck passed!'",
		"test": "bun test",
		"db:generate": "bun scripts/db-utils && bunx --bun drizzle-kit generate --config=drizzle.config.ts",
		"db:migrate": "bun scripts/db-utils && bunx --bun drizzle-kit migrate --config=drizzle.config.ts",
		"dev": "bun run --watch src/index.ts",
		"start": "bun run scripts/entrypoint.ts",
		"compile": "bun run ./scripts/compile"
	},
	"dependencies": {
		"@cleverjs/utils": "^1.2.5",
		"@hono/standard-validator": "^0.3.0",
		"@scalar/hono-api-reference": "^0.11.9",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.12.30",
		"hono-openapi": "^1.3.1",
		"nodemailer": "^9.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@cleverjs/cli": "^2.4.0",
		"@libsql/client": "^0.17.4",
		"@types/nodemailer": "^8.0.1",
		"drizzle-kit": "^0.31.10",
		"bun-types": "^1.3.14",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"typescript": "^6.0.3 || ^7.0.0"
	}
}