{
	"name": "@leicraftmc/static-site-with-docs-template",
	"private": true,
	"type": "module",
	"description": "LeiCraftMC static site + docs Nuxt template",
	"scripts": {
		"check": "bunx --bun biome check",
		"check:ci": "bunx --bun biome ci",
		"format": "bunx --bun biome format --write",
		"lint": "bunx --bun biome lint",
		"typecheck": "bunx --bun nuxt typecheck && bunx --bun tsc -p ./tsconfig/tsconfig.typecheck.json && echo 'Typecheck passed!'",
		"test": "bun test",
		"dev": "bunx --bun nuxt dev --port 12531",
		"generate": "bunx --bun nuxt generate",
		"preview": "bunx --bun nuxt preview",
		"postinstall": "bunx --bun nuxt prepare",
		"build": "nuxt build --preset static"
	},
	"dependencies": {
		"@nuxt/content": "^3.5.0",
		"@nuxt/ui": "^4.9.0",
		"@tailwindcss/typography": "^0.5.20",
		"nuxt": "^4.4.8"
	},
	"devDependencies": {
		"@iconify-json/lucide": "^1.2.117",
		"@biomejs/biome": "^2.5.0",
		"bun-types": "^1.4.2",
		"typescript": "^6.0.3",
		"vue-tsc": "^3.3.6"
	}
}
